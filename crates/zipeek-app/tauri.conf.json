{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zipeek",
  "version": "0.1.0",
  "identifier": "com.jozef.zipeek",
  "build": {
    "beforeDevCommand": {
      "script": ".\\target\\release\\zipeek-cli.exe desktop-frontend --serve",
      "cwd": "../..",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": ".\\target\\release\\zipeek-cli.exe desktop-frontend --release",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:1421/",
    "frontendDist": "../zipeek-web/dist-desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "zipeek",
        "width": 1000,
        "height": 700,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "binaries/duckdb.dll": "duckdb.dll",
      "binaries/dictionary/hanzi.duckdb": "dictionary/hanzi.duckdb"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/zipeek-ai-server",
      "binaries/zipeek-image-server",
      "binaries/zipeek-tts-stt"
    ]
  }
}
